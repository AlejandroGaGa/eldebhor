# Copia este archivo a .env.local. Nunca subas .env.local a git.

# --- Panel de administración (/estudio) ---
# Dueño del panel: con este correo y contraseña entras y puedes dar acceso a otras personas.
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=una-contraseña-larga-y-única
# Texto largo al azar (mínimo 32 caracteres) para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- Base de datos en producción (Vercel): Upstash Redis, plan gratis ---
# En local no hace falta: los cambios se guardan en .data/db.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
